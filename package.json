{
  "name": "auto-research-agent",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepare:fasttext": "python3 scripts/prepare_fasttext_agnews.py",
    "validate:skills": "python3 scripts/validate_skills.py",
    "probe:pi": "tsx scripts/pi_sdk_probe.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "better-sqlite3": "13.0.3",
    "typebox": "1.3.7",
    "yaml": "2.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
