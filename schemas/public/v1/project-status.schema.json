{
  "$id": "https://auto-research.local/schemas/v1/project-status.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "smoke",
            "exploratory",
            "confirmatory"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "scoped",
            "protocol_ready",
            "frozen",
            "confirmation_observed",
            "closed",
            "derived"
          ]
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "direction",
        "domain",
        "profile",
        "status",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "selected",
              "superseded",
              "rejected"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "status",
          "question"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "assumptions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hypothesisSets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "protocols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deviations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "derivations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "assumptions",
        "hypothesisSets",
        "protocols",
        "approvals",
        "deviations",
        "derivations"
      ],
      "additionalProperties": false
    },
    "confirmationObserved": {
      "type": "boolean"
    },
    "persistence": {
      "type": "object",
      "properties": {
        "rootProjectId": {
          "type": "string",
          "minLength": 1
        },
        "parentProjectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "branchName": {
          "type": "string",
          "minLength": 1
        },
        "lastEventSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "rootProjectId",
        "parentProjectId",
        "branchName",
        "lastEventSequence",
        "eventCount"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "project",
    "questions",
    "counts",
    "confirmationObserved",
    "persistence"
  ],
  "additionalProperties": false
}
