{
  "$id": "https://auto-research.local/schemas/v1/project-dependencies.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "lastImport": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "degraded",
                "blocked"
              ]
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "warning",
                      "error"
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "severity",
                  "subject",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "checkedAt": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "issues",
            "checkedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "contentHash": {
            "type": "string"
          },
          "originScope": {
            "type": "string",
            "enum": [
              "project",
              "workspace"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "missing",
              "incompatible"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "pluginId",
          "version",
          "contentHash",
          "originScope",
          "status",
          "permissions"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentHash": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "public",
              "project",
              "private"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "embedded",
              "content_addressed",
              "missing",
              "private_omitted"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "missing",
              "restricted"
            ]
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "contentHash",
          "access",
          "disposition",
          "status",
          "uri"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "projectId",
    "lastImport",
    "plugins",
    "artifacts"
  ],
  "additionalProperties": false
}
