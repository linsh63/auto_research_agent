{
  "$id": "https://auto-research.local/schemas/v1/service-capabilities.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "serviceVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "transports": {
      "type": "object",
      "properties": {
        "rest": {
          "type": "boolean",
          "const": true
        },
        "sse": {
          "type": "boolean",
          "const": true
        },
        "websocket": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "rest",
        "sse",
        "websocket"
      ],
      "additionalProperties": false
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "network",
          "process",
          "gpu",
          "model",
          "secrets",
          "confirmation",
          "host.full"
        ]
      }
    },
    "offline": {
      "type": "boolean"
    },
    "telemetry": {
      "type": "boolean",
      "const": false
    },
    "publicExports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "linux",
            "darwin",
            "win32",
            "other"
          ]
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "nodeVersion": {
          "type": "string",
          "minLength": 1
        },
        "pythonVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "executors": {
          "type": "object",
          "properties": {
            "python": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "bubblewrap": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "pi": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "python",
            "bubblewrap",
            "pi"
          ],
          "additionalProperties": false
        },
        "sandbox": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "degraded",
                "not_checked"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        "resourceLimits": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "degraded",
                "not_checked"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        "processGroups": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "degraded",
                "not_checked"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        "storageModes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "local",
              "cas_sync",
              "remote_existing"
            ]
          }
        },
        "filesystem": {
          "type": "object",
          "properties": {
            "pathSeparator": {
              "type": "string",
              "enum": [
                "/",
                "\\"
              ]
            },
            "caseSensitive": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "pathSeparator",
            "caseSensitive"
          ],
          "additionalProperties": false
        },
        "ssh": {
          "type": "object",
          "properties": {
            "client": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "sftp": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "proxyJump": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            },
            "multiplexing": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "available",
                    "unavailable",
                    "degraded",
                    "not_checked"
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "client",
            "version",
            "sftp",
            "proxyJump",
            "multiplexing"
          ],
          "additionalProperties": false
        },
        "detectedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "arch",
        "nodeVersion",
        "pythonVersion",
        "executors",
        "sandbox",
        "resourceLimits",
        "processGroups",
        "storageModes",
        "filesystem",
        "ssh",
        "detectedAt"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string"
    }
  },
  "required": [
    "serviceVersion",
    "schemaVersion",
    "transports",
    "endpoints",
    "allowedPermissions",
    "offline",
    "telemetry",
    "publicExports",
    "platform",
    "startedAt"
  ],
  "additionalProperties": false
}
