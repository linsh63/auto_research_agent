{
  "$id": "https://auto-research.local/schemas/v1/command-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "data": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_COMMAND",
                "INCOMPATIBLE_VERSION",
                "NOT_FOUND",
                "CONFLICT",
                "FORBIDDEN",
                "GATE_REJECTED",
                "INTERNAL"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "code",
            "message",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "eventIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "handledAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "workspaceId",
    "projectId",
    "status",
    "data",
    "error",
    "eventIds",
    "handledAt"
  ],
  "additionalProperties": false
}
