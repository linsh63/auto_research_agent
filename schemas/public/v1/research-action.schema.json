                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "question",
                "rationale",
                "targetPopulation",
                "intervention",
                "comparator",
                "primaryOutcome",
                "scope",
                "sourceIds"
              ],
              "additionalProperties": false
            }
