            "type": "string"
          }
        },
        "assumptionRefs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedInformationGain": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "estimatedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "risks": {
          "type": "array",
