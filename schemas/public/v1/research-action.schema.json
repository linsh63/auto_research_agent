                  "minLength": 3
                },
                "comparator": {
                  "type": "string",
                  "minLength": 3
                },
                "primaryOutcome": {
                  "type": "string",
                  "minLength": 3
                },
                "scope": {
                  "type": "string",
                  "minLength": 10
                },
                "sourceIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "supersedesId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
