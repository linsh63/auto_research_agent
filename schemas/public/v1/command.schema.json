            "kind": {
              "type": "string",
              "enum": [
                "user",
                "agent",
                "worker",
                "system"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        },
        "issuedAt": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "question.propose"
        },
        "payload": {
          "type": "object",
          "properties": {
            "question": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 20
                },
                "rationale": {
                  "type": "string",
                  "minLength": 20
                },
                "targetPopulation": {
                  "type": "string",
                  "minLength": 3
                },
                "intervention": {
                  "type": "string",
                  "minLength": 3
                },
                "comparator": {
                  "type": "string",
                  "minLength": 3
                },
                "primaryOutcome": {
                  "type": "string",
                  "minLength": 3
                },
                "scope": {
                  "type": "string",
                  "minLength": 10
                },
                "sourceIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "supersedesId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "question",
                "rationale",
                "targetPopulation",
                "intervention",
                "comparator",
                "primaryOutcome",
                "scope",
                "sourceIds"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "commandId",
        "idempotencyKey",
        "workspaceId",
        "projectId",
        "actor",
        "issuedAt",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
