{
  "$id": "https://auto-research.local/schemas/v1/query.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "queryId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "project.status"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "user",
                "agent",
                "worker",
                "system"
              ]
            },
            "displayName": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "queryId",
        "type",
        "workspaceId",
        "projectId",
        "actor"
      ],
      "additionalProperties": false
    }
  ]
}
