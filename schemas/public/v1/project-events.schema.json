{
  "$id": "https://auto-research.local/schemas/v1/project-events.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "actor": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "user",
                  "agent",
                  "worker",
                  "system"
                ]
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "causationId": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "filesystem.read",
                "filesystem.write",
                "network",
                "process",
                "gpu",
                "model",
                "secrets",
                "confirmation",
                "host.full"
              ]
            }
          },
          "externalServices": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payloadHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "payload": {}
        },
        "required": [
          "schemaVersion",
          "eventId",
          "type",
          "workspaceId",
          "projectId",
          "sequence",
          "actor",
          "causationId",
          "correlationId",
          "occurredAt",
          "permissions",
          "externalServices",
          "payloadHash",
          "payload"
        ],
        "additionalProperties": false
      }
    },
    "nextSequence": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "workspaceId",
    "projectId",
    "events",
    "nextSequence"
  ],
  "additionalProperties": false
}
