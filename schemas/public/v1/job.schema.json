{
  "$id": "https://auto-research.local/schemas/v1/job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "spec": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "dataRole": {
              "type": "string",
              "enum": [
                "exploration",
                "confirmation"
              ]
            },
            "studyId": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "execution": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "python"
                    },
                    "workspace": {
                      "type": "string",
                      "minLength": 1
                    },
                    "script": {
                      "type": "string",
                      "minLength": 1
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "artifactPaths": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "workspace",
                    "script",
                    "args",
                    "env",
                    "artifactPaths"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "bubblewrap"
                    },
                    "workspace": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "type": "string",
                      "format": "starts_with",
                      "pattern": "^\\/.*"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "artifactPaths": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "workspace",
                    "command",
                    "args",
                    "env",
                    "artifactPaths"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "pi"
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sessionFile": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "allowedTools": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "prompt",
                    "sessionFile",
                    "allowedTools"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "resources": {
              "type": "object",
              "properties": {
                "cpuCores": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryMiB": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "diskMiB": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "gpuCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "cpuCores",
                "memoryMiB",
                "diskMiB",
                "gpuCount"
              ],
              "additionalProperties": false
            },
            "limits": {
              "type": "object",
              "properties": {
                "wallTimeMs": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "cpuTimeSeconds": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxOutputBytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxArtifactBytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "wallTimeMs",
                "cpuTimeSeconds",
                "maxOutputBytes",
                "maxArtifactBytes"
              ],
              "additionalProperties": false
            },
            "priority": {
              "default": 0,
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            },
            "resumable": {
              "default": true,
              "type": "boolean"
            },
            "maxAttempts": {
              "default": 3,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "name",
            "dataRole",
            "studyId",
            "execution",
            "resources",
            "limits",
            "priority",
            "resumable",
            "maxAttempts"
          ],
          "additionalProperties": false
        },
        "currentAttempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancelRequested": {
          "type": "boolean"
        },
        "failureClass": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "environment",
                "data",
                "scientific",
                "budget",
                "timeout",
                "cancelled",
                "worker_lost"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "failureMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "workspaceId",
        "projectId",
        "status",
        "spec",
        "currentAttempt",
        "cancelRequested",
        "failureClass",
        "failureMessage",
        "createdAt",
        "updatedAt",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "jobId": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "default": "project",
            "type": "string",
            "enum": [
              "public",
              "project",
              "private"
            ]
          },
          "createdAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "jobId",
          "attempt",
          "name",
          "mediaType",
          "contentHash",
          "bytes",
          "uri",
          "access",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "job",
    "artifacts"
  ],
  "additionalProperties": false
}
