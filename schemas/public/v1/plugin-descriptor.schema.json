{
  "$id": "https://auto-research.local/schemas/v1/plugin-descriptor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "descriptorId": {
      "type": "string",
      "minLength": 1
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceKind": {
      "type": "string",
      "enum": [
        "local",
        "git",
        "npm",
        "pi_config"
      ]
    },
    "sourceLocation": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contributions": {
      "type": "object",
      "properties": {
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "apps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "extensions",
        "skills",
        "prompts",
        "themes",
        "tools",
        "apps",
        "mcp",
        "scenarios"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "filesystem.read",
          "filesystem.write",
          "network",
          "process",
          "gpu",
          "model",
          "secrets",
          "confirmation",
          "host.full"
        ]
      }
    },
    "sideEffects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coreSchemaRange": {
      "type": "string",
      "minLength": 1
    },
    "piVersionRange": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityStatus": {
      "type": "string",
      "enum": [
        "compatible",
        "incompatible"
      ]
    },
    "compatibilityIssues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "discoveredAt": {
      "type": "string"
    }
  },
  "required": [
    "descriptorId",
    "pluginId",
    "name",
    "version",
    "description",
    "domain",
    "license",
    "maintainers",
    "sourceId",
    "sourceKind",
    "sourceLocation",
    "contentHash",
    "contributions",
    "permissions",
    "sideEffects",
    "dependencies",
    "coreSchemaRange",
    "piVersionRange",
    "compatibilityStatus",
    "compatibilityIssues",
    "discoveredAt"
  ],
  "additionalProperties": false
}
