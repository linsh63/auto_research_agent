{
  "$id": "https://auto-research.local/schemas/v1/worker-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "worker.claim"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "type": "object",
          "properties": {
            "workerId": {
              "type": "string",
              "minLength": 1
            },
            "protocolVersion": {
              "type": "string",
              "const": "1"
            },
            "executors": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "python",
                  "bubblewrap",
                  "pi"
                ]
              }
            },
            "capacity": {
              "type": "object",
              "properties": {
                "cpuCores": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "memoryMiB": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "diskMiB": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "gpuCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "cpuCores",
                "memoryMiB",
                "diskMiB",
                "gpuCount"
              ],
              "additionalProperties": false
            },
            "gpuDevices": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^\\d+$"
              }
            },
            "leaseDurationMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 300000
            },
            "platform": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "os": {
                      "type": "string",
                      "enum": [
                        "linux",
                        "darwin",
                        "win32",
                        "other"
                      ]
                    },
                    "arch": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nodeVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pythonVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "executors": {
                      "type": "object",
                      "properties": {
                        "python": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        "bubblewrap": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        "pi": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "python",
                        "bubblewrap",
                        "pi"
                      ],
                      "additionalProperties": false
                    },
                    "sandbox": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "unavailable",
                            "degraded",
                            "not_checked"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "resourceLimits": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "unavailable",
                            "degraded",
                            "not_checked"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "processGroups": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "unavailable",
                            "degraded",
                            "not_checked"
                          ]
                        },
                        "reason": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "storageModes": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "local",
                          "cas_sync",
                          "remote_existing"
                        ]
                      }
                    },
                    "filesystem": {
                      "type": "object",
                      "properties": {
                        "pathSeparator": {
                          "type": "string",
                          "enum": [
                            "/",
                            "\\"
                          ]
                        },
                        "caseSensitive": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "pathSeparator",
                        "caseSensitive"
                      ],
                      "additionalProperties": false
                    },
                    "ssh": {
                      "type": "object",
                      "properties": {
                        "client": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        "version": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "sftp": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        "proxyJump": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        },
                        "multiplexing": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "available",
                                "unavailable",
                                "degraded",
                                "not_checked"
                              ]
                            },
                            "reason": {
                              "type": [
                                "string",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "status",
                            "reason"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "client",
                        "version",
                        "sftp",
                        "proxyJump",
                        "multiplexing"
                      ],
                      "additionalProperties": false
                    },
                    "detectedAt": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "os",
                    "arch",
                    "nodeVersion",
                    "pythonVersion",
                    "executors",
                    "sandbox",
                    "resourceLimits",
                    "processGroups",
                    "storageModes",
                    "filesystem",
                    "ssh",
                    "detectedAt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "workerId",
            "protocolVersion",
            "executors",
            "capacity",
            "gpuDevices",
            "leaseDurationMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "requestId",
        "worker"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "leaseToken": {
          "type": "string",
          "minLength": 32
        },
        "type": {
          "type": "string",
          "const": "worker.heartbeat"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "leaseDurationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        }
      },
      "required": [
        "jobId",
        "attempt",
        "workerId",
        "leaseToken",
        "type",
        "requestId",
        "leaseDurationMs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "leaseToken": {
          "type": "string",
          "minLength": 32
        },
        "type": {
          "type": "string",
          "const": "worker.log"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "stream": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr",
            "progress",
            "system"
          ]
        },
        "message": {
          "type": "string"
        },
        "data": {}
      },
      "required": [
        "jobId",
        "attempt",
        "workerId",
        "leaseToken",
        "type",
        "requestId",
        "stream",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "leaseToken": {
          "type": "string",
          "minLength": 32
        },
        "type": {
          "type": "string",
          "const": "worker.complete"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mediaType": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "access": {
                "default": "project",
                "type": "string",
                "enum": [
                  "public",
                  "project",
                  "private"
                ]
              }
            },
            "required": [
              "name",
              "mediaType",
              "contentHash",
              "bytes",
              "uri",
              "access"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "jobId",
        "attempt",
        "workerId",
        "leaseToken",
        "type",
        "requestId",
        "artifacts"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "workerId": {
          "type": "string",
          "minLength": 1
        },
        "leaseToken": {
          "type": "string",
          "minLength": 32
        },
        "type": {
          "type": "string",
          "const": "worker.fail"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "failureClass": {
          "type": "string",
          "enum": [
            "environment",
            "data",
            "scientific",
            "budget",
            "timeout",
            "cancelled",
            "worker_lost"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "jobId",
        "attempt",
        "workerId",
        "leaseToken",
        "type",
        "requestId",
        "failureClass",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "worker.recover"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "requestId"
      ],
      "additionalProperties": false
    }
  ]
}
