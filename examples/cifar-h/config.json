{
  "architecture": "torchvision resnet18 with CIFAR stem",
  "epochs": 12,
  "batchSize": 128,
  "optimizer": "SGD(momentum=0.9,nesterov=true,weight_decay=0.0005)",
  "learningRate": 0.1,
  "scheduler": "cosine",
  "seeds": [11, 23, 47],
