{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-research-agent.local/schemas/research-capability-result-v1.json",
  "title": "Research Capability Benchmark v1 Result",
  "type": "object",
  "required": ["schemaVersion", "benchmark", "environment", "fixtureRootHash", "dimensions", "realCases", "summary", "deterministicGateHash", "comparison"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "benchmark": {"type": "object", "required": ["id", "version", "manifestHash"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "manifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "environment": {"type": "object", "required": ["coreVersion", "publicSchemaVersion", "implementationHash", "repositoryHead", "node", "platform", "arch", "model", "knownCostUsd", "elapsedMs"], "additionalProperties": false, "properties": {"coreVersion": {"type": "string"}, "publicSchemaVersion": {"type": "string"}, "implementationHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "repositoryHead": {"type": "string"}, "node": {"type": "string"}, "platform": {"type": "string"}, "arch": {"type": "string"}, "model": {"type": ["string", "null"]}, "knownCostUsd": {"type": "number"}, "elapsedMs": {"type": "integer", "minimum": 0}}},
    "fixtureRootHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dimensions": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "required": ["id", "title", "cases", "machineSummary", "humanSummary"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "cases": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/case"}}, "machineSummary": {"enum": ["demonstrated", "partial", "not_evaluated", "failed"]}, "humanSummary": {"enum": ["pending", "reviewed"]}}}},
    "realCases": {"type": "array", "items": {"type": "object", "required": ["id", "role", "inputHash", "status", "artifactHashes"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "role": {"const": "external_real_case"}, "inputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "status": {"enum": ["pass", "fail", "unavailable"]}, "artifactHashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}},
    "summary": {"type": "object", "required": ["dimensionsDemonstrated", "dimensionsPartial", "dimensionsNotEvaluated", "dimensionsFailed", "machineGate", "humanReview"], "additionalProperties": false, "properties": {"dimensionsDemonstrated": {"type": "integer"}, "dimensionsPartial": {"type": "integer"}, "dimensionsNotEvaluated": {"type": "integer"}, "dimensionsFailed": {"type": "integer"}, "machineGate": {"enum": ["pass", "fail"]}, "humanReview": {"const": "pending"}}},
    "deterministicGateHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "comparison": {"anyOf": [{"type": "null"}, {"type": "object", "required": ["baselineImplementationHash", "candidateImplementationHash", "schemaCompatible", "changedCases", "sameGateHash"], "additionalProperties": false, "properties": {"baselineImplementationHash": {"type": "string"}, "candidateImplementationHash": {"type": "string"}, "schemaCompatible": {"type": "boolean"}, "changedCases": {"type": "array", "items": {"type": "object"}}, "sameGateHash": {"type": "boolean"}}}]}
  },
  "$defs": {
    "case": {"type": "object", "required": ["id", "kind", "expectedOutcome", "capabilityOutcome", "gateResult", "reasonCode", "inputHash", "outputHash", "artifactHashes", "publicOperations", "humanReview"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "kind": {"enum": ["success", "adversarial"]}, "expectedOutcome": {"enum": ["demonstrated", "rejected", "degraded", "not_evaluated"]}, "capabilityOutcome": {"enum": ["demonstrated", "rejected", "degraded", "not_evaluated", "failed"]}, "gateResult": {"enum": ["pass", "fail", "not_evaluated"]}, "reasonCode": {"type": "string"}, "inputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "outputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifactHashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "publicOperations": {"type": "array", "items": {"type": "string"}}, "humanReview": {"type": "object", "required": ["status", "rubric", "reviewer", "notes"], "additionalProperties": false, "properties": {"status": {"enum": ["pending", "reviewed"]}, "rubric": {"type": "string"}, "reviewer": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}}}}
  }
}
